# API
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
TRUST_PROXY_HOPS=0

# Local PostgreSQL (default)
DATABASE_URL=postgresql://waste_app:replace_me@localhost:5432/waste_management

# Supabase PostgreSQL pooler (use your database password; do not commit it)
# DATABASE_URL=postgresql://postgres.<project-ref>:<YOUR_PASSWORD>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

WEB_ORIGIN=http://localhost:3000
PRIVATE_STORAGE_DIR=./storage/private
PUBLIC_REPORT_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_REPORT_RATE_LIMIT_MAX=8

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# One-time administrator bootstrap only; remove after use.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
